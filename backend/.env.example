# Copy to .env. Never commit .env; keys stay on the backend only.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_KEY_RAG=nvapi-...        # chat model: help answers, wording polish, fallback translation
NVIDIA_KEY_EMBED=nvapi-...      # embeddings for the help assistant
NVIDIA_KEY_TRANSLATE=nvapi-...  # Riva translate (Hindi <-> English verified)
NVIDIA_KEY_TTS=nvapi-...        # Magpie text-to-speech (Hindi, English)
NVIDIA_KEY_STT=nvapi-...        # Parakeet speech-to-text
# Optional overrides. NVIDIA retires models, so check build.nvidia.com if a call returns 410/404.
# NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
# NVIDIA_TRANSLATE_MODEL=nvidia/riva-translate-4b-instruct-v2
# NVIDIA_RPM_LIMIT=35
WEBHOOK_SECRET=dev-only-secret
DB_PATH=rti.db
